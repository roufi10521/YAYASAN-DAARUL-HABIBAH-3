      "required": ["code", "name", "category"]
    },
    "journalEntries": {
      "title": "Journal Entries",
      "description": "Transaksi Jurnal Umum & Buku Kas Umum",
      "properties": {
        "date": { "type": "string", "description": "Tanggal Transaksi" },
        "voucherNo": { "type": "string", "description": "Nomor Bukti Voucher" },
        "description": { "type": "string", "description": "Keterangan" },
